# Build-time deployment configuration. Copy to .env for local deploys.
# In Cloudflare Workers Builds, set these as build variables/secrets instead.
BABY_LOG_WORKER_NAME=baby-log
BABY_LOG_ROUTE_PATTERN=baby.example.com
BABY_LOG_D1_DATABASE_NAME=baby_log
BABY_LOG_D1_DATABASE_ID=replace-with-d1-database-id
BABY_LOG_KEEP_VARS=true

# Optional alternatives:
# BABY_LOG_ROUTE_ZONE_NAME=example.com
# BABY_LOG_WORKERS_DEV=false
# BABY_LOG_WRANGLER_CONFIG=wrangler.generated.toml
